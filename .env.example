# Copy to .env. Replace the placeholders in section 1, then uncomment only
# the optional settings you want to change. Commented values are examples.
# Leaving optional settings unset preserves --config JSON and built-in defaults.
# Priority: CLI > process environment > .env > --config JSON > defaults.

# 1. Minimal setup for automatic clip discovery
# This example uses OpenAI. Choose another backend/model/key if needed.
# --clip-range and --clip-full skip AI and do not require these three settings.
LLM_BACKEND=openai
LLM_MODEL=YOUR_MODEL
OPENAI_API_KEY=YOUR_API_KEY

# 2. Optional shared settings
# These output settings apply to both short and long cuts and their variants.
# Boolean values are true/false. Every compatible output has captions by default.
# RENDER=true
# VARIANTS=true
# SUBTITLE_ENABLED=true
# SUBTITLE_TEMPLATE=yellow-pop
# SUBTITLE_TEMPLATE_DIR=/path/to/templates

# Shared font size; section 3 shows how to override it by class or variant.
# SUBTITLE_FONT_SIZE=4%

# Override the preferred primary format for both classes: 9:16, 16:9, 1:1, original.
# Without an override, shorts prefer 9:16 and longs prefer 16:9.
# ASPECT_RATIO=9:16

# Optional analysis and transcription settings; these have no output scope.
# LLM_EFFORT=medium
# ANTHROPIC_API_KEY=YOUR_API_KEY
# GEMINI_API_KEY=YOUR_API_KEY
# BLOCK_CHARS=24000
# BLOCK_OVERLAP_CHARS=4000
# OVERLAP_THRESHOLD=0.60
# ASR_BACKEND=whisperx
# ASR_MODEL=turbo

# 3. Optional class and variant examples
# In .env, the scope belongs in the VARIABLE NAME; the value stays unchanged.
# Within each source, variant overrides class overrides shared, per field.
# The examples below are independent; enable only the settings you need.

# 3.1 Class scope: SHORT or LONG
# Override the shared font size for every short output.
# SUBTITLE_SHORT_FONT_SIZE=5%

# Disable long cuts and all their outputs. At least one class must stay enabled.
# RENDER_LONG=false

# Publish only the primary short format unless a named render setting enables more.
# VARIANTS_SHORT=false
# ASPECT_RATIO_SHORT=9:16

# 3.2 Variant scope: CLASS_VARIANT
# Override the short font size only for vertical shorts.
# CLI equivalent: --subtitle-font-size short:vertical=6%
# SUBTITLE_SHORT_VERTICAL_FONT_SIZE=6%

# Resize vertical shorts to 720x1280; an omitted dimension follows the variant ratio.
# WIDTH_SHORT_VERTICAL=720

# Resize horizontal longs to 1280x720, or square shorts to 720x720.
# HEIGHT_LONG_HORIZONTAL=720
# WIDTH_SHORT_SQUARE=720

# Enable one additional short output, even with VARIANTS_SHORT=false.
# RENDER_SHORT_HORIZONTAL_BLUR=true

# Disable captions only for horizontal shorts with a blurred background.
# SUBTITLE_SHORT_HORIZONTAL_BLUR_ENABLED=false

# Use positive even pixel dimensions. Derived dimensions round to even pixels;
# supplied width/height pairs must preserve the ratio. Original framing cannot resize.
# Variants: HORIZONTAL, VERTICAL, SQUARE, HORIZONTAL_BLUR, VERTICAL_BLUR, SQUARE_BLUR.
# Check README's orientation table before explicitly enabling a variant.
# RENDER, WIDTH, HEIGHT, and all SUBTITLE fields accept class/variant scopes.
# VARIANTS and ASPECT_RATIO accept shared or class scopes only.

# 4. Subtitle reference
# Settings below override the selected template. Enable only the fields you need.
# Shared enabled/template/template_dir/font_size settings are shown in section 2.
# Apply the same scope pattern to EVERY field. For example, SUBTITLE_POSITION
# becomes SUBTITLE_SHORT_POSITION or SUBTITLE_SHORT_VERTICAL_POSITION.
# Presentation changes reuse transcription and AI caches.

# Positioning: use native position/margins OR custom coordinates.
# Only top positions accept margin_top; only bottom positions accept margin_bottom.
# Custom coordinates require position_x/y, anchor, max_width/height together,
# without position or margin overrides.
# SUBTITLE_POSITION=bottom-center
# SUBTITLE_MARGIN_LEFT=18%
# SUBTITLE_MARGIN_RIGHT=18%
# SUBTITLE_MARGIN_TOP=0%
# SUBTITLE_MARGIN_BOTTOM=8%
# SUBTITLE_MAX_WIDTH=80%
# SUBTITLE_MAX_HEIGHT=20%
# SUBTITLE_POSITION_X=50%
# SUBTITLE_POSITION_Y=80%
# SUBTITLE_ANCHOR=bottom-center

# Typography: choose font_weight OR bold. Lengths use % or px where supported.
# SUBTITLE_FONT=Montserrat
# SUBTITLE_FONT_WEIGHT=600
# SUBTITLE_BOLD=false
# SUBTITLE_ITALIC=false
# SUBTITLE_TEXT_CASE=original
# SUBTITLE_FONTS_DIR=/path/to/fonts
# Font size is shown in section 2.
# SUBTITLE_LETTER_SPACING=0px
# SUBTITLE_LINE_HEIGHT=auto

# Appearance: quote hexadecimal colors; opacity accepts 0% through 100%.
# SUBTITLE_TEXT_COLOR='#FFFFFF'
# SUBTITLE_BACKDROP=none
# SUBTITLE_BACKDROP_COLOR='#00000099'
# SUBTITLE_WORD_BACKDROP=none
# SUBTITLE_WORD_BACKDROP_COLOR='#111827E6'
# SUBTITLE_OPACITY=100%
# SUBTITLE_BACKDROP_SIZE=25%
# SUBTITLE_WORD_BACKDROP_SIZE=25%
# SUBTITLE_SHADOW_SIZE=0px

# Animations: durations accept 10ms-5000ms (or seconds, such as 0.15s).
# Set a phase to none to disable it; none/highlight phases have no duration override.
# SUBTITLE_ANIMATION_CUE_TEXT_ENTRANCE=fade
# SUBTITLE_ANIMATION_CUE_TEXT_ENTRANCE_DURATION=150ms
# SUBTITLE_ANIMATION_CUE_TEXT_EMPHASIS=pulse
# SUBTITLE_ANIMATION_CUE_TEXT_EMPHASIS_DURATION=150ms
# SUBTITLE_ANIMATION_CUE_TEXT_EXIT=fade
# SUBTITLE_ANIMATION_CUE_TEXT_EXIT_DURATION=150ms
# SUBTITLE_ANIMATION_CUE_BACKDROP_ENTRANCE=fade
# SUBTITLE_ANIMATION_CUE_BACKDROP_ENTRANCE_DURATION=150ms
# SUBTITLE_ANIMATION_CUE_BACKDROP_EMPHASIS=pulse
# SUBTITLE_ANIMATION_CUE_BACKDROP_EMPHASIS_DURATION=150ms
# SUBTITLE_ANIMATION_CUE_BACKDROP_EXIT=fade
# SUBTITLE_ANIMATION_CUE_BACKDROP_EXIT_DURATION=150ms
# SUBTITLE_ANIMATION_WORD_TEXT_ENTRANCE=fade
# SUBTITLE_ANIMATION_WORD_TEXT_ENTRANCE_DURATION=150ms
# SUBTITLE_ANIMATION_WORD_TEXT_EMPHASIS=pulse
# SUBTITLE_ANIMATION_WORD_TEXT_EMPHASIS_DURATION=150ms
# SUBTITLE_ANIMATION_WORD_TEXT_EXIT=fade
# SUBTITLE_ANIMATION_WORD_TEXT_EXIT_DURATION=150ms
# SUBTITLE_ANIMATION_WORD_BACKDROP_ENTRANCE=fade
# SUBTITLE_ANIMATION_WORD_BACKDROP_ENTRANCE_DURATION=150ms
# SUBTITLE_ANIMATION_WORD_BACKDROP_EMPHASIS=pulse
# SUBTITLE_ANIMATION_WORD_BACKDROP_EMPHASIS_DURATION=150ms
# SUBTITLE_ANIMATION_WORD_BACKDROP_EXIT=fade
# SUBTITLE_ANIMATION_WORD_BACKDROP_EXIT_DURATION=150ms
# SUBTITLE_ANIMATION_WORD_TEXT_MODE=active-word
# SUBTITLE_ANIMATION_WORD_BACKDROP_MODE=active-word
# Highlight color requires word-text emphasis=highlight, without its duration override.
# SUBTITLE_ANIMATION_WORD_TEXT_HIGHLIGHT_COLOR='#FFD54F'
# SUBTITLE_DISABLE_CUE_ANIMATIONS=false
# SUBTITLE_DISABLE_WORD_ANIMATIONS=false

# Source, output directory, intervals, language, editorial context, cache bypass,
# intermediate-file retention, and verbosity are per-run CLI choices. See README.md.
