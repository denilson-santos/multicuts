# Copy to .env and replace the placeholders in the minimal setup.
# All other assignments are commented and document the default configuration.
# Empty values mean unset: keep those lines commented until you supply a value.
# Leaving optional settings unset preserves --config JSON and template defaults.
# Priority: CLI > process environment > .env > --config JSON > defaults.

# 1. Minimal setup for automatic discovery (OpenAI example)
# Backend and model have no built-in defaults. Other backends may use other keys.
# --clip-range and --clip-full skip AI and do not require these three settings.
LLM_BACKEND=openai
LLM_MODEL=YOUR_MODEL
OPENAI_API_KEY=YOUR_API_KEY

# 2. Analysis and transcription defaults
# auto leaves reasoning effort to the provider. Alternative API keys are unset.
# LLM_EFFORT=auto
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# BLOCK_CHARS=24000
# BLOCK_OVERLAP_CHARS=4000
# OVERLAP_THRESHOLD=0.60
# ASR_BACKEND=whisperx
# ASR_MODEL=turbo

# 3. Output defaults
# Both classes and every source-compatible variant are enabled, with captions.
# RENDER=true
# VARIANTS=true
# SUBTITLE_ENABLED=true
# SUBTITLE_TEMPLATE=yellow-pop
# SUBTITLE_TEMPLATE_DIR=

# Shared primary format is unset because each class has a different preference.
# ASPECT_RATIO=
# ASPECT_RATIO_SHORT=9:16
# ASPECT_RATIO_LONG=16:9

# Width/height are unset; each variant uses its default final canvas:
# horizontal/horizontal-blur: 1920x1080; vertical/vertical-blur: 1080x1920;
# square/square-blur: 1080x1080. Original framing keeps native dimensions.
# WIDTH=
# HEIGHT=

# Scope belongs in the variable name. Shared values are inherited by each class
# and named variant; no class or variant overrides are set by default.
# Output pattern: RENDER -> RENDER_SHORT -> RENDER_SHORT_VERTICAL.
# Subtitle pattern: SUBTITLE_FONT_SIZE -> SUBTITLE_SHORT_FONT_SIZE
# -> SUBTITLE_SHORT_VERTICAL_FONT_SIZE. This works for every subtitle field.
# RENDER, WIDTH, HEIGHT, and SUBTITLE fields accept class/variant scopes.
# VARIANTS and ASPECT_RATIO accept shared or class scopes only.
# Within each source: variant overrides class overrides shared, per field.
# A disabled class suppresses all its outputs; at least one class must stay enabled.
# Check README's orientation table before explicitly enabling a named variant.

# 4. Subtitle defaults for yellow-pop (multisubs 5.1.0)
# These are inherited from the default template; choosing another template changes
# its inherited values. Only uncomment settings you want to override explicitly.

# Positioning.
# SUBTITLE_POSITION=bottom-center
# SUBTITLE_MARGIN_LEFT=18%
# SUBTITLE_MARGIN_RIGHT=18%
# SUBTITLE_MARGIN_BOTTOM=3%

# Top margin is inactive for bottom-center; leave unset (native value: 0%).
# Only top positions accept margin_top; only bottom positions accept margin_bottom.
# SUBTITLE_MARGIN_TOP=

# Maxima are unset overrides. Native defaults are 100% of usable width and 9.8%
# of usable height; explicit percentages instead use the full render dimensions.
# SUBTITLE_MAX_WIDTH=
# SUBTITLE_MAX_HEIGHT=

# Custom coordinates are unset. Supply x/y, anchor, max_width/height together,
# without native position or margin overrides.
# SUBTITLE_POSITION_X=
# SUBTITLE_POSITION_Y=
# SUBTITLE_ANCHOR=

# Typography.
# SUBTITLE_FONT=Montserrat
# SUBTITLE_FONT_WEIGHT=extra-bold
# SUBTITLE_ITALIC=false
# SUBTITLE_TEXT_CASE=uppercase
# SUBTITLE_FONT_SIZE=4.9%
# SUBTITLE_LETTER_SPACING=0px
# SUBTITLE_LINE_HEIGHT=auto

# Bold shorthand is unset; the template uses extra-bold (800).
# Set font_weight OR bold, never both. No extra font directory is configured.
# SUBTITLE_BOLD=
# SUBTITLE_FONTS_DIR=

# Appearance. Quote hexadecimal colors; lengths use % or px where supported.
# SUBTITLE_TEXT_COLOR='#FFFFFF'
# SUBTITLE_BACKDROP=outline
# SUBTITLE_BACKDROP_COLOR='#111827'
# SUBTITLE_WORD_BACKDROP=none
# SUBTITLE_WORD_BACKDROP_COLOR='#111827E6'
# SUBTITLE_OPACITY=100%
# SUBTITLE_BACKDROP_SIZE=5%
# SUBTITLE_WORD_BACKDROP_SIZE=25%
# SUBTITLE_SHADOW_SIZE=0px

# Cue animations: disabled phases have no duration override (native duration: 0ms).
# To add an effect, set its phase and optionally a duration from 10ms to 5000ms.
# SUBTITLE_ANIMATION_CUE_TEXT_ENTRANCE=none
# SUBTITLE_ANIMATION_CUE_TEXT_ENTRANCE_DURATION=
# SUBTITLE_ANIMATION_CUE_TEXT_EMPHASIS=none
# SUBTITLE_ANIMATION_CUE_TEXT_EMPHASIS_DURATION=
# SUBTITLE_ANIMATION_CUE_TEXT_EXIT=none
# SUBTITLE_ANIMATION_CUE_TEXT_EXIT_DURATION=
# SUBTITLE_ANIMATION_CUE_BACKDROP_ENTRANCE=none
# SUBTITLE_ANIMATION_CUE_BACKDROP_ENTRANCE_DURATION=
# SUBTITLE_ANIMATION_CUE_BACKDROP_EMPHASIS=none
# SUBTITLE_ANIMATION_CUE_BACKDROP_EMPHASIS_DURATION=
# SUBTITLE_ANIMATION_CUE_BACKDROP_EXIT=none
# SUBTITLE_ANIMATION_CUE_BACKDROP_EXIT_DURATION=

# Word animations: pop entrance, highlight emphasis, and no exit/backdrop effects.
# Disabled and highlight phases have no duration override (native duration: 0ms).
# SUBTITLE_ANIMATION_WORD_TEXT_ENTRANCE=pop
# SUBTITLE_ANIMATION_WORD_TEXT_ENTRANCE_DURATION=120ms
# SUBTITLE_ANIMATION_WORD_TEXT_EMPHASIS=highlight
# SUBTITLE_ANIMATION_WORD_TEXT_EMPHASIS_DURATION=
# SUBTITLE_ANIMATION_WORD_TEXT_EXIT=none
# SUBTITLE_ANIMATION_WORD_TEXT_EXIT_DURATION=
# SUBTITLE_ANIMATION_WORD_BACKDROP_ENTRANCE=none
# SUBTITLE_ANIMATION_WORD_BACKDROP_ENTRANCE_DURATION=
# SUBTITLE_ANIMATION_WORD_BACKDROP_EMPHASIS=none
# SUBTITLE_ANIMATION_WORD_BACKDROP_EMPHASIS_DURATION=
# SUBTITLE_ANIMATION_WORD_BACKDROP_EXIT=none
# SUBTITLE_ANIMATION_WORD_BACKDROP_EXIT_DURATION=
# SUBTITLE_ANIMATION_WORD_TEXT_MODE=active-word
# SUBTITLE_ANIMATION_WORD_BACKDROP_MODE=active-word
# SUBTITLE_ANIMATION_WORD_TEXT_HIGHLIGHT_COLOR='#FBE003'
# SUBTITLE_DISABLE_CUE_ANIMATIONS=false
# SUBTITLE_DISABLE_WORD_ANIMATIONS=false

# CLI-only controls have no environment equivalent: source, --output-dir, --config,
# --search-range, --clip-range, --clip-full, --lang, --context, --keep-intermediates,
# --force-recompute, and --verbose (including their negative aliases).
