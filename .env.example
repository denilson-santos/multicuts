# Copy to .env and set one backend and model.

LLM_BACKEND=openai
LLM_MODEL=YOUR_MODEL
# LLM_EFFORT=medium
OPENAI_API_KEY=YOUR_API_KEY
# ANTHROPIC_API_KEY=YOUR_API_KEY
# GEMINI_API_KEY=YOUR_API_KEY
ASR_BACKEND=whisperx
ASR_MODEL=turbo
OVERLAP_THRESHOLD=0.60
# Primary versions: 9:16, 16:9, 1:1, or original.
# Square outputs have no variants; false publishes only the primary version.
# Enabled variants include vertical, horizontal, and square social formats.
RENDER_VARIANTS=true
SHORT_ASPECT_RATIO=9:16
LONG_ASPECT_RATIO=16:9
VERTICAL_WIDTH=1080
VERTICAL_HEIGHT=1920
HORIZONTAL_WIDTH=1920
HORIZONTAL_HEIGHT=1080
SQUARE_SIZE=1080
# Subtitle switches apply independently to every version of each class.
SHORT_SUBTITLES_ENABLED=true
LONG_SUBTITLES_ENABLED=true
SUBTITLE_TEMPLATE=yellow-pop
# SUBTITLE_TEMPLATE_DIR=/path/to/templates
BLOCK_CHARS=24000
BLOCK_OVERLAP_CHARS=4000
