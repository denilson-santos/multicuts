# Copy to .env and set one backend and model.

# AI backend, credentials, and transcript context windows.
LLM_BACKEND=openai
LLM_MODEL=YOUR_MODEL
# LLM_EFFORT=medium
OPENAI_API_KEY=YOUR_API_KEY
# ANTHROPIC_API_KEY=YOUR_API_KEY
# GEMINI_API_KEY=YOUR_API_KEY
BLOCK_CHARS=24000
BLOCK_OVERLAP_CHARS=4000

# Transcription.
ASR_BACKEND=whisperx
ASR_MODEL=turbo

# Clip classes. A disabled class has no primary output or variants.
# At least one class must remain enabled.
SHORT_CLIPS_ENABLED=true
LONG_CLIPS_ENABLED=true
OVERLAP_THRESHOLD=0.60

# Formats. Square primary outputs have no variants.
# Unset class overrides inherit RENDER_VARIANTS.
RENDER_VARIANTS=true
# SHORT_VARIANTS_ENABLED=true
# LONG_VARIANTS_ENABLED=true
# Primary versions: 9:16, 16:9, 1:1, or original.
SHORT_ASPECT_RATIO=9:16
LONG_ASPECT_RATIO=16:9

# Dimensions. Positive, even pixels; preserve the named aspect ratio.
VERTICAL_WIDTH=1080
VERTICAL_HEIGHT=1920
HORIZONTAL_WIDTH=1920
HORIZONTAL_HEIGHT=1080
SQUARE_SIZE=1080

# Primary subtitles. Unset variant overrides inherit their class setting.
SHORT_SUBTITLES_ENABLED=true
LONG_SUBTITLES_ENABLED=true
# SHORT_VARIANT_SUBTITLES_ENABLED=true
# LONG_VARIANT_SUBTITLES_ENABLED=true
SUBTITLE_TEMPLATE=yellow-pop
# SUBTITLE_TEMPLATE_DIR=/path/to/templates

# Per-run CLI only: source, output directory, language, editorial context,
# cache bypass, intermediate-file retention, and verbosity.
