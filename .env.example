# Copy to .env and replace the setup placeholders.
# Optional defaults are commented; empty values mean unset. Uncomment only to override.
# Priority: CLI > environment > .env > JSON > defaults.

# Minimal setup (OpenAI; --clip-range/--clip-full skip AI).
LLM_BACKEND=openai
LLM_MODEL=YOUR_MODEL
OPENAI_API_KEY=YOUR_API_KEY

# Scopes: all, short, long, or TYPE:VARIANT (TYPE is short/long).
# Scope           Environment example
# all             SUBTITLE_FONT_SIZE=4.9%
# short           SUBTITLE_SHORT_FONT_SIZE=4.9%
# short:vertical  SUBTITLE_SHORT_VERTICAL_FONT_SIZE=4.9%
# In short:vertical=4.9%: scope=short:vertical, variant=vertical, value=4.9%.
# CLI: --subtitle-font-size [SCOPE=]VALUE; omitted scope means all.
# Render variant: --render short:vertical=false -> RENDER_SHORT_VERTICAL=false.
# Variants: horizontal, vertical, square, horizontal-blur, vertical-blur, square-blur.
# .env: horizontal-blur -> HORIZONTAL_BLUR. Per source: variant > type > all.
# VARIANTS and ASPECT_RATIO accept only all, short, or long.

# Analysis and transcription.
# LLM_EFFORT=auto
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# BLOCK_CHARS=24000
# BLOCK_OVERLAP_CHARS=4000
# OVERLAP_THRESHOLD=0.60
# ASR_BACKEND=whisperx
# ASR_MODEL=turbo

# Outputs: all source-compatible variants and captions are enabled.
# RENDER=true
# VARIANTS=true
# SUBTITLE_ENABLED=true
# SUBTITLE_TEMPLATE=yellow-pop
# SUBTITLE_TEMPLATE_DIR=

# Primary format: shared override is unset; defaults differ by type.
# ASPECT_RATIO=
# ASPECT_RATIO_SHORT=9:16
# ASPECT_RATIO_LONG=16:9

# Canvas defaults: horizontal 1920x1080, vertical 1080x1920, square 1080x1080.
# Blur variants use the same canvas sizes; original keeps native dimensions.
# WIDTH=
# HEIGHT=

# Subtitles: inherited yellow-pop defaults (multisubs 5.1.0).
# Positioning.
# SUBTITLE_POSITION=bottom-center
# SUBTITLE_MARGIN_LEFT=18%
# SUBTITLE_MARGIN_RIGHT=18%
# SUBTITLE_MARGIN_TOP=
# SUBTITLE_MARGIN_BOTTOM=3%
# SUBTITLE_MAX_WIDTH=
# SUBTITLE_MAX_HEIGHT=
# SUBTITLE_POSITION_X=
# SUBTITLE_POSITION_Y=
# SUBTITLE_ANCHOR=

# Typography: choose FONT_WEIGHT or BOLD.
# SUBTITLE_FONT=Montserrat
# SUBTITLE_FONT_WEIGHT=extra-bold
# SUBTITLE_BOLD=
# SUBTITLE_ITALIC=false
# SUBTITLE_TEXT_CASE=uppercase
# SUBTITLE_FONTS_DIR=
# SUBTITLE_FONT_SIZE=4.9%
# SUBTITLE_LETTER_SPACING=0px
# SUBTITLE_LINE_HEIGHT=auto

# Appearance.
# SUBTITLE_TEXT_COLOR='#FFFFFF'
# SUBTITLE_BACKDROP=outline
# SUBTITLE_BACKDROP_COLOR='#111827'
# SUBTITLE_WORD_BACKDROP=none
# SUBTITLE_WORD_BACKDROP_COLOR='#111827E6'
# SUBTITLE_OPACITY=100%
# SUBTITLE_BACKDROP_SIZE=5%
# SUBTITLE_WORD_BACKDROP_SIZE=25%
# SUBTITLE_SHADOW_SIZE=0px

# Cue animations.
# SUBTITLE_ANIMATION_CUE_TEXT_ENTRANCE=none
# SUBTITLE_ANIMATION_CUE_TEXT_ENTRANCE_DURATION=
# SUBTITLE_ANIMATION_CUE_TEXT_EMPHASIS=none
# SUBTITLE_ANIMATION_CUE_TEXT_EMPHASIS_DURATION=
# SUBTITLE_ANIMATION_CUE_TEXT_EXIT=none
# SUBTITLE_ANIMATION_CUE_TEXT_EXIT_DURATION=
# SUBTITLE_ANIMATION_CUE_BACKDROP_ENTRANCE=none
# SUBTITLE_ANIMATION_CUE_BACKDROP_ENTRANCE_DURATION=
# SUBTITLE_ANIMATION_CUE_BACKDROP_EMPHASIS=none
# SUBTITLE_ANIMATION_CUE_BACKDROP_EMPHASIS_DURATION=
# SUBTITLE_ANIMATION_CUE_BACKDROP_EXIT=none
# SUBTITLE_ANIMATION_CUE_BACKDROP_EXIT_DURATION=

# Word animations: none/highlight phases have no duration override.
# SUBTITLE_ANIMATION_WORD_TEXT_ENTRANCE=pop
# SUBTITLE_ANIMATION_WORD_TEXT_ENTRANCE_DURATION=120ms
# SUBTITLE_ANIMATION_WORD_TEXT_EMPHASIS=highlight
# SUBTITLE_ANIMATION_WORD_TEXT_EMPHASIS_DURATION=
# SUBTITLE_ANIMATION_WORD_TEXT_EXIT=none
# SUBTITLE_ANIMATION_WORD_TEXT_EXIT_DURATION=
# SUBTITLE_ANIMATION_WORD_BACKDROP_ENTRANCE=none
# SUBTITLE_ANIMATION_WORD_BACKDROP_ENTRANCE_DURATION=
# SUBTITLE_ANIMATION_WORD_BACKDROP_EMPHASIS=none
# SUBTITLE_ANIMATION_WORD_BACKDROP_EMPHASIS_DURATION=
# SUBTITLE_ANIMATION_WORD_BACKDROP_EXIT=none
# SUBTITLE_ANIMATION_WORD_BACKDROP_EXIT_DURATION=
# SUBTITLE_ANIMATION_WORD_TEXT_MODE=active-word
# SUBTITLE_ANIMATION_WORD_BACKDROP_MODE=active-word
# SUBTITLE_ANIMATION_WORD_TEXT_HIGHLIGHT_COLOR='#FBE003'
# SUBTITLE_DISABLE_CUE_ANIMATIONS=false
# SUBTITLE_DISABLE_WORD_ANIMATIONS=false

# See README.md for valid combinations, source orientation, and CLI-only controls.
